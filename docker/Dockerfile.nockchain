# Multi-stage Dockerfile for building nockchain from source
# This eliminates the need to mount host binaries and builds all tools locally

# ==============================================================================
# Stage 1: Builder - Build all nockchain tools from source
# ==============================================================================
FROM ubuntu:22.04 AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    clang \
    llvm-dev \
    libclang-dev \
    make \
    build-essential \
    pkg-config \
    libssl-dev \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Install newer protoc from GitHub releases (Ubuntu 22.04's protoc is too old)
# proto3 optional fields require protoc 3.15+, Ubuntu 22.04 ships with 3.12.x
ARG PROTOC_VERSION=25.1
RUN curl -LO "https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-linux-x86_64.zip" && \
    unzip "protoc-${PROTOC_VERSION}-linux-x86_64.zip" -d /usr/local && \
    rm "protoc-${PROTOC_VERSION}-linux-x86_64.zip" && \
    chmod +x /usr/local/bin/protoc

# Install Rust (stable for nockchain, nightly for nockup)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"

# Install nightly toolchain (required by nockup)
RUN rustup toolchain install nightly --profile minimal && \
    rustup update nightly

# ==============================================================================
# Build nockchain ecosystem tools
# ==============================================================================

# Clone nockchain repository
# Using sigilante/nockchain fork with public gRPC server enabled
ARG NOCKCHAIN_VERSION=master
WORKDIR /build/nockchain
RUN git clone https://github.com/sigilante/nockchain.git . && \
    git checkout ${NOCKCHAIN_VERSION}

# Build hoonc (Hoon compiler) - needed for building Hoon assets
RUN cargo install --locked --force --path crates/hoonc --bin hoonc

# Build hoon (Hoon runtime/interpreter)
RUN cargo build --release --bin hoon

# Build Hoon assets (.jam files) using the compiled hoonc
RUN make build-hoon-all || echo "Warning: build-hoon-all failed, continuing anyway"

# Verify assets were created and list them for debugging
RUN ls -la crates/nockchain/assets/ || echo "No nockchain assets directory" && \
    ls -la crates/nockchain-wallet/assets/ || echo "No nockchain-wallet assets directory"

# Build nockchain and nockchain-wallet binaries
RUN cargo build --release --bin nockchain --bin nockchain-wallet

# ==============================================================================
# Build nockup tool
# ==============================================================================

# Clone nockup repository
ARG NOCKUP_VERSION=master
WORKDIR /build/nockup
RUN git clone https://github.com/sigilante/nockup.git . && \
    git checkout ${NOCKUP_VERSION}

# Build nockup with explicit nightly toolchain (override any rust-toolchain file)
RUN rustup override set nightly && \
    cargo build --release --bin nockup

# ==============================================================================
# Stage 2: Runtime - Minimal image with only necessary components
# ==============================================================================
FROM ubuntu:22.04

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    curl \
    jq \
    netcat \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN useradd -m -u 1000 -s /bin/bash nockchain

# Create necessary directories
RUN mkdir -p /data /config /assets && \
    chown -R nockchain:nockchain /data /config /assets

# Copy binaries from builder stage
COPY --from=builder /build/nockchain/target/release/nockchain /usr/local/bin/nockchain
COPY --from=builder /build/nockchain/target/release/nockchain-wallet /usr/local/bin/nockchain-wallet
COPY --from=builder /build/nockchain/target/release/hoon /usr/local/bin/hoon
COPY --from=builder /root/.cargo/bin/hoonc /usr/local/bin/hoonc
COPY --from=builder /build/nockup/target/release/nockup /usr/local/bin/nockup

# Note: Hoon assets are not copied as they may be embedded in binaries
# or not needed for fakenet mode. The make build-hoon-all step may have
# failed or the assets directories may not exist in the build output.

# Ensure binaries are executable
RUN chmod +x /usr/local/bin/nockchain \
             /usr/local/bin/nockchain-wallet \
             /usr/local/bin/hoon \
             /usr/local/bin/hoonc \
             /usr/local/bin/nockup

# Switch to non-root user
USER nockchain

# Set working directory
WORKDIR /data

# Expose ports
EXPOSE 8545 8546 30303 5555

# Default command - pass mining PKH and bind to all interfaces for Docker access
# Note: Bind to 0.0.0.0 to allow external connections from host
CMD ["/bin/sh", "-c", "/usr/local/bin/nockchain --mine --fakenet --mining-pkh=\"${MINING_PKH}\" --bind-public-grpc-addr=0.0.0.0:5555"]
