FROM ubuntu:22.04

# Install dependencies
RUN apt-get update && apt-get install -y \
    curl \
    jq \
    netcat \
    && rm -rf /var/lib/apt/lists/*

# Copy nockchain binary (assuming it's built elsewhere)
COPY --from=nockchain-build $HOME/.cargo/bin/nockchain /usr/local/bin/nockchain

# Create data directory
RUN mkdir -p /data /config

# Copy entrypoint
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8545 8546 30303 5555

ENTRYPOINT ["/entrypoint.sh"]
CMD ["--mine", "--fakenet"]
