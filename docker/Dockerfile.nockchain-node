# syntax=docker/dockerfile:1
# Multi-stage Dockerfile for building nockchain NODE from source
# This image runs a non-mining nockchain node (suitable for wallets, queries, etc.)
# This eliminates the need to mount host binaries and builds all tools locally

# ==============================================================================
# Stage 1: Builder - Build all nockchain tools from source
# ==============================================================================
FROM ubuntu:22.04 AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    clang \
    llvm-dev \
    libclang-dev \
    make \
    build-essential \
    pkg-config \
    libssl-dev \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Install newer protoc from GitHub releases (Ubuntu 22.04's protoc is too old)
# proto3 optional fields require protoc 3.15+, Ubuntu 22.04 ships with 3.12.x
ARG PROTOC_VERSION=25.1
RUN curl -LO "https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-linux-x86_64.zip" && \
    unzip "protoc-${PROTOC_VERSION}-linux-x86_64.zip" -d /usr/local && \
    rm "protoc-${PROTOC_VERSION}-linux-x86_64.zip" && \
    chmod +x /usr/local/bin/protoc

# Install Rust. The nockchain workspace pins its own toolchain via
# rust-toolchain.toml (covers nockchain, nockup, and every other workspace
# member alike), so rustup auto-installs it on first cargo invocation below -
# the bootstrap channel here doesn't need to match.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"

# ==============================================================================
# Build nockchain ecosystem tools
# ==============================================================================

# Fetch nockchain source as a tarball rather than `git clone`: git's HTTPS
# transport on Debian/Ubuntu links against GnuTLS, which has proven flaky
# against github.com from some networks ("GnuTLS recv error (-9)" mid-clone).
# curl (OpenSSL-backed here) doesn't hit that, and a tarball is smaller than
# even a shallow clone since it skips .git entirely.
ARG NOCKCHAIN_VERSION=master
WORKDIR /build/nockchain
RUN curl -fsSL "https://github.com/sigilante/nockchain/archive/${NOCKCHAIN_VERSION}.tar.gz" -o /tmp/nockchain-src.tar.gz && \
    tar xzf /tmp/nockchain-src.tar.gz --strip-components=1 -C . && \
    rm /tmp/nockchain-src.tar.gz

# Registry/git dependency caches for cargo below. This workspace pulls a few
# dependencies straight from git (e.g. op-alloy-* from the entire
# ethereum-optimism/optimism monorepo, submodules and all - a 10+ minute
# fetch on its own), and a killed/retried RUN otherwise redoes that fetch
# from zero since Docker only commits a layer once a RUN fully completes.
# Cache mounts persist across retries even when the RUN itself doesn't. The
# same cache ids are used in Dockerfile.nockchain-miner so both images share
# one download cache.
ARG CARGO_REGISTRY_CACHE=cargo-registry
ARG CARGO_GIT_CACHE=cargo-git

# Build hoonc (Hoon compiler) - needed for building Hoon assets
RUN --mount=type=cache,target=/root/.cargo/registry,id=${CARGO_REGISTRY_CACHE} \
    --mount=type=cache,target=/root/.cargo/git,id=${CARGO_GIT_CACHE} \
    cargo -Z unstable-options -Z git=shallow-deps install --locked --force --path crates/hoonc --bin hoonc

# Build hoon (Hoon runtime/interpreter)
RUN --mount=type=cache,target=/root/.cargo/registry,id=${CARGO_REGISTRY_CACHE} \
    --mount=type=cache,target=/root/.cargo/git,id=${CARGO_GIT_CACHE} \
    cargo -Z unstable-options -Z git=shallow-deps build --release --bin hoon

# Build Hoon assets (.jam files) using the compiled hoonc
RUN make build-hoon-all || echo "Warning: build-hoon-all failed, continuing anyway"

# Verify assets were created and list them for debugging
RUN ls -la crates/nockchain/assets/ || echo "No nockchain assets directory" && \
    ls -la crates/nockchain-wallet/assets/ || echo "No nockchain-wallet assets directory"

# Build nockchain, nockchain-wallet, and nockup binaries. nockup is a
# workspace member of this same repo now (crates/nockup), not a separate
# clone. This node never mines, so zk-pow-mine isn't built here. This is the
# heaviest compile in the build (zkvm-jetpack, ai-pow-zk/Plonky3 STARK code,
# nockvm), so target/ is cache-mounted too, making a killed/retried build
# resume from its last compiled objects instead of recompiling from scratch.
# Cache-mounted paths don't persist into the image layer on their own, so
# the binaries are copied out to a plain directory before the RUN ends.
RUN --mount=type=cache,target=/root/.cargo/registry,id=${CARGO_REGISTRY_CACHE} \
    --mount=type=cache,target=/root/.cargo/git,id=${CARGO_GIT_CACHE} \
    --mount=type=cache,target=/build/nockchain/target,id=nockchain-node-target \
    cargo -Z unstable-options -Z git=shallow-deps build --release --bin nockchain --bin nockchain-wallet --bin nockup && \
    mkdir -p /build/out && \
    cp target/release/nockchain target/release/nockchain-wallet target/release/nockup /build/out/

# ==============================================================================
# Stage 2: Runtime - Minimal image with only necessary components
# ==============================================================================
FROM ubuntu:22.04

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    gnupg \
    jq \
    netcat \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN useradd -m -u 1000 -s /bin/bash nockchain

# Create necessary directories
RUN mkdir -p /data /config /assets && \
    chown -R nockchain:nockchain /data /config /assets

# Copy binaries from builder stage. nockchain/nockchain-wallet/nockup were
# compiled with target/ cache-mounted (see above), so they were copied to
# /build/out/ before that mount unmounted - only hoon and hoonc come
# straight from their normal (non-cache-mounted) build outputs.
COPY --from=builder /build/out/nockchain /usr/local/bin/nockchain
COPY --from=builder /build/out/nockchain-wallet /usr/local/bin/nockchain-wallet
COPY --from=builder /build/nockchain/target/release/hoon /usr/local/bin/hoon
COPY --from=builder /root/.cargo/bin/hoonc /usr/local/bin/hoonc
COPY --from=builder /build/out/nockup /usr/local/bin/nockup

# Copy genesis JAM files for fakenet
COPY --from=builder /build/nockchain/crates/nockchain/jams /assets

# Ensure binaries are executable
RUN chmod +x /usr/local/bin/nockchain \
             /usr/local/bin/nockchain-wallet \
             /usr/local/bin/hoon \
             /usr/local/bin/hoonc \
             /usr/local/bin/nockup

# Copy entrypoint script for automated wallet derivation
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Switch to non-root user
USER nockchain

# Add nockup bin directory to PATH for nockchain user
ENV PATH="/home/nockchain/.nockup/bin:${PATH}"

# Set working directory
WORKDIR /data

# Expose ports
EXPOSE 8545 8546 30303 5555

# Set entrypoint to handle wallet derivation
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

# Default environment: non-mining mode, connects to miner
ENV ENABLE_MINING=false
ENV PEER_MULTIADDR=/dns4/nockchain-fakenet-miner/udp/30303/quic-v1

# No CMD needed - entrypoint handles everything
# Additional arguments can be passed via docker-compose or docker run
