# Nockchain Fakenet Docker Environment Configuration
# Copy this file to .env and customize as needed

# ==============================================================================
# Build Configuration
# ==============================================================================

# Nockchain version to build (use 'master' for latest, or a specific git tag)
NOCKCHAIN_VERSION=master

# ==============================================================================
# Mining Configuration
# ==============================================================================

# Public Key Hash (PKH) that receives mining rewards
# This is a sample fakenet PKH - generate your own using: nockchain-wallet create --fakenet
MINING_PKH=9yPePjfWAdUnzaQKyxcRXKRa5PpUzKKEwtpECBZsUYt9Jd7egSDEWoV

# Enable fakenet mode (true/false)
FAKENET=true

# Proof-of-Work difficulty length (lower = easier)
# Mainnet uses higher values, fakenet typically uses 2-4 for faster mining
POW_LEN=2

# Minimum coinbase maturity time in blocks
# Set to 0 for immediate access to mined coins (useful for testing)
COINBASE_TIMELOCK_MIN=0

# ==============================================================================
# Port Configuration
# ==============================================================================

# RPC port (default: 8545)
RPC_PORT=8545

# WebSocket port (default: 8546)
WS_PORT=8546

# P2P networking port (default: 30303)
P2P_PORT=30303

# gRPC port (default: 5555)
GRPC_PORT=5555

# ==============================================================================
# Logging Configuration
# ==============================================================================

# Rust log level (error, warn, info, debug, trace)
# RUST_LOG=info

# ==============================================================================
# Data Directories
# ==============================================================================

# If you prefer bind mounts instead of named volumes, uncomment these:
# DATA_DIR=./data
# CONFIG_DIR=./config
