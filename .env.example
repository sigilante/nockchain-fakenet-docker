# Nockchain Fakenet Docker Environment Configuration
# Copy this file to .env and customize as needed

# ==============================================================================
# Build Configuration
# ==============================================================================

# Nockchain version to build (use 'master' for latest, or a specific git tag).
# Must be a branch or tag name, not a commit SHA - the Dockerfiles fetch this
# ref as a GitHub archive tarball (not a git clone) to keep the from-source
# build fast and reliable. nockup is built from this same checkout (it's a
# workspace crate in nockchain/nockchain now, not a separate repo), so
# there's no separate NOCKUP_VERSION to set.
NOCKCHAIN_VERSION=master

# Protocol Buffers compiler version (must be 3.15+ for proto3 optional fields)
# Ubuntu 22.04 ships with 3.12.x which is too old, so we install from GitHub
PROTOC_VERSION=25.1

# ==============================================================================
# Wallet Configuration (Automated)
# ==============================================================================

# Standard fakenet seed phrase (BIP39)
FAKENET_SEEDPHRASE=farm step rhythm surprise math august panther pulse protect remain anger depend adjust sting enable poet describe stone essay blast click horse hair practice

# Master PKH (parent key - used by miner and first node)
FAKENET_MASTER_PKH=9yPePjfWAdUnzaQKyxcRXKRa5PpUzKKEwtpECBZsUYt9Jd7egSDEWoV

# Default configuration:
# - Miner: Uses master PKH (no derivation)
# - First node: Also uses master PKH (same wallet as miner)
# - Additional nodes: Derive child keys starting from index 1
#
# To add more nodes with unique wallets:
# nockchain-node-2:
#   environment:
#     - USE_MASTER_PKH=false
#     - CHILD_KEY_INDEX=1  # First child key (skip index 0)
#
# nockchain-node-3:
#   environment:
#     - USE_MASTER_PKH=false
#     - CHILD_KEY_INDEX=2  # Second child key
#
# Note: Child index 0 is skipped to avoid confusion with master key

# ==============================================================================
# Fakenet Configuration
# ==============================================================================

# V1 phase parameter
FAKENET_V1_PHASE=1

# Proof-of-Work length (higher = harder)
# 2 keeps mining fast for local dev. 64 mimics mainnet-grade difficulty but
# will slow to a crawl within a few blocks on typical dev hardware - only
# raise it (with a matching genesis jam below) if you specifically want to
# exercise real PoW difficulty.
FAKENET_POW_LEN=2

# Logarithmic difficulty (bex parameter)
# Works with POW_LEN: difficulty = 2^(FAKENET_LOG_DIFFICULTY)
FAKENET_LOG_DIFFICULTY=1

# Genesis JAM file path
# Pre-computed genesis state matching the POW parameters above - must be
# swapped together with FAKENET_POW_LEN/FAKENET_LOG_DIFFICULTY, not alone.
FAKENET_GENESIS_JAM_PATH=/assets/fakenet-genesis-pow-2-bex-1.jam

# zk-pow-mine worker thread count (miner container only). Each thread runs a
# full STARK-proving kernel instance, and zk-pow-mine's own default (host
# CPUs - 1) can OOM a Docker Desktop VM that doesn't have proportionally
# large memory allocated to it - matters even at this easy difficulty, and
# much more so if you raise FAKENET_POW_LEN. Raise this if you've given
# Docker more memory and want faster blocks.
ZK_POW_MINE_THREADS=2

# ==============================================================================
# Port Configuration
# ==============================================================================

# Miner Node Ports
# gRPC API port for miner - primary interface for wallet operations and queries (default: 5555)
MINER_GRPC_PORT=5555

# P2P networking port for miner (default: 30303)
MINER_P2P_PORT=30303

# Non-Mining Node Ports
# gRPC API port for node - use this for wallet operations (default: 5556)
NODE_GRPC_PORT=5556

# P2P networking port for node (default: 30304)
NODE_P2P_PORT=30304

# ==============================================================================
# Logging Configuration
# ==============================================================================

# Rust log level (error, warn, info, debug, trace)
# RUST_LOG=info

# ==============================================================================
# Data Directories
# ==============================================================================

# If you prefer bind mounts instead of named volumes, uncomment these:
# DATA_DIR=./data
# CONFIG_DIR=./config
